<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report name" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="0c724bee-dae1-4ae0-a0c9-5e49b8203f4f">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="ENTERPRISE_NAME_FR" class="java.lang.String"/>
	<parameter name="ENTERPRISE_ID" class="java.lang.String"/>
	<parameter name="DATE_VERSEMENT" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT Entreprise.nom_ar , Entreprise.nom_fr ,Versement_Entreprise.montant, Versement_Entreprise.mode_paiement, Versement_Entreprise.date_versement 
,Versement_Entreprise.total_credit as old_credit,Versement_Entreprise.reste_credit
FROM Entreprise INNER JOIN Versement_Entreprise ON Entreprise.id = Versement_Entreprise.id_entreprise WHERE Entreprise.id  = $P{ENTERPRISE_ID} AND  Versement_Entreprise.date_versement = $P{DATE_VERSEMENT} ;]]>
	</queryString>
	<field name="nom_ar" class="java.lang.String"/>
	<field name="nom_fr" class="java.lang.String"/>
	<field name="montant" class="java.lang.Double"/>
	<field name="mode_paiement" class="java.lang.String"/>
	<field name="date_versement" class="java.sql.Timestamp"/>
	<field name="old_credit" class="java.lang.Double"/>
	<field name="reste_credit" class="java.lang.Double"/>
	<variable name="LAST_CREADIT" class="java.lang.Double">
		<variableExpression><![CDATA[$F{reste_credit}]]></variableExpression>
	</variable>
	<variable name="ALL_VERSEMENT" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{montant}]]></variableExpression>
	</variable>
	<variable name="ALL_CREDIT" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{old_credit}]]></variableExpression>
	</variable>
